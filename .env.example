# Copy to .env only on your machine. Never commit .env.
# The process reads the environment. It does not load this file for you.
#   set -a && source .env && set +a

# fake is the only provider the exercises and CI use.
WORKSHOP_PROVIDER=fake

# Live calls stay off. CI must leave this at 0.
WORKSHOP_ENABLE_LIVE_PROVIDER=0
WORKSHOP_LIVE_BASE_URL=
WORKSHOP_LIVE_API_KEY=

# Simulated budget for one run. Not a vendor price.
WORKSHOP_BUDGET_USD=0.01
WORKSHOP_MAX_STEPS=6
WORKSHOP_MAX_ATTEMPTS=3
WORKSHOP_BACKOFF_CAP_S=0.05
WORKSHOP_LOG_LEVEL=INFO

# Optional LLM judge. Off unless LIVE_MODE=1 and every variable below is set.
# CI must not set these. Put the prices you read, and the date you read them.
# Leave the key empty in this file.
LIVE_MODE=0
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
MAX_LIVE_SPEND_USD=
LLM_INPUT_USD_PER_TOKEN=
LLM_OUTPUT_USD_PER_TOKEN=
LLM_PRICE_DATE=
